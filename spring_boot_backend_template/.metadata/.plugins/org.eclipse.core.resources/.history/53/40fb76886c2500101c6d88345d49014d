package com.blogs.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.blogs.entity.Employee;
import com.blogs.entity.Task;
import com.blogs.service.TaskService;

import io.swagger.v3.oas.annotations.parameters.RequestBody;

@RestController
@CrossOrigin(origins = "http://localhost:3000")
@RequestMapping("/api")

public class TaskController {
	
	@Autowired 
	private TaskService taskService;
	
	@GetMapping("/tasks")
	public List<Task> getAll(){
		return taskService.getalltask();
	}

	@PostMapping("/task")
	public Task addTasks(Task task) {
		
		return taskService.add(task);
	}
	
	
	@PutMapping("/task{id}")
	Task updateTask( @RequestBody Task e, @PathVariable Long id) {
		return  taskService.update(id, e);
	}
	
}
